{
  "name": "five-in-a-row",
  "version": "0.1.0",
  "description": "Educational Five-in-a-Row (Gomoku) game where players answer Python questions before placing a piece. Built with Next.js and Supabase.",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "create-teacher": "node --env-file=.env.local scripts/create-teacher.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "1.2.4",
    "@supabase/supabase-js": "^2.76.1",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/analytics": "^1.5.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^0.454.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.9",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
