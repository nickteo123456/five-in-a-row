# Copy this file to .env.local and fill in the values.
# Leave the Supabase values empty to run in dev mode (in-memory data, no database).

# --- Supabase ---
# Project URL (Project Settings -> Data API).
NEXT_PUBLIC_SUPABASE_URL=
# Service role key. Server-only: never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessions ---
# Signs the session cookie. Required in production, at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Site ---
# Public address of the site, without a trailing slash. Used in password reset
# links and social previews.
APP_URL=

# --- Email (optional) ---
# Password reset emails are sent through Resend (https://resend.com).
# Without these, the reset page works but no email goes out.
RESEND_API_KEY=
# For example: Connect Five <noreply@your-domain.com>
EMAIL_FROM=

# --- Teacher account ---
# Used by `npm run create-teacher` and by the dev-mode user store. Registering
# through the app always creates a student, even with this email.
TEACHER_EMAIL=
# At least 12 characters.
TEACHER_PASSWORD=
# Display name for the teacher account (defaults to "Teacher").
TEACHER_NAME=
